# ErgoVigilance frontend — TLS termination example (production).
#
# How to use:
#   1. Obtain a certificate (Let's Encrypt/certbot, or a self-signed pair for
#      internal testing:  openssl req -x509 -nodes -newkey rsa:2048 \
#        -keyout key.pem -out cert.pem -days 365 -subj "/CN=ergovigilance")
#   2. Mount certs + this config into the frontend container, e.g. in
#      docker-compose.yml add to the `frontend` service:
#        volumes:
#          - ./certs/fullchain.pem:/etc/nginx/ssl/fullchain.pem:ro
#          - ./certs/privkey.pem:/etc/nginx/ssl/privkey.pem:ro
#          - ./ui_posture/nginx.tls.conf.example:/etc/nginx/conf.d/default.conf:ro
#      and map 443:  ports: ["443:443"]
#   3. In the backend .env set TRUST_PROXY_HEADERS=true (already the default
#      in docker-compose) so X-Forwarded-For/Proto are honored.

server_tokens off;

# Redirect plain HTTP -> HTTPS
server {
    listen 80;
    server_name _;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name _;

    ssl_certificate     /etc/nginx/ssl/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;

    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size 200m;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
    proxy_connect_timeout 10s;

    # Strict Transport Security — only once TLS is working; 31536000 = 1 year.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "camera=(self), microphone=(), geolocation=()" always;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /api/ {
        proxy_pass http://backend:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /ws/ {
        proxy_pass http://backend:8000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
