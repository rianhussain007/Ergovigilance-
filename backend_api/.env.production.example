# ErgoVigilance API — PRODUCTION Environment Template
# Copy to .env on the deployment host and fill in real values.
# Every value below is required or has a safe production default.

# ── Server ──────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
# MUST be false in production. With DEBUG=false the API refuses to start
# unless AUTH_JWT_SECRET is set to a strong (>=32 char) non-default value.
DEBUG=false

# CORS — comma-separated origins. Set to the real UI origin(s).
CORS_ORIGINS=https://app.yourcompany.com

# ── Repository ──────────────────────────────────────────────────────────
# Live mode (false) fails closed with HTTP 503 if the monitoring service is
# unavailable. NEVER enable mock mode in production.
USE_MOCK_REPOSITORY=false

# ── Security ────────────────────────────────────────────────────────────
# REQUIRED with DEBUG=false. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_JWT_SECRET=replace-with-a-48-char-random-secret

# Auth DB location (persistent volume in containers).
AUTH_DB_PATH=/data/local_auth.db

# ── Tier 1 telemetry store (PostgreSQL / TimescaleDB) ──────────────────
# Optional. When set, session summaries + per-frame timeline rows are
# mirrored into Postgres and reads prefer it (fast indexed queries for
# analytics + predictive ML). Unset = sessions stay in JSON files.
# Leave unset for single-site offline deployments.
#DATABASE_URL=postgresql://ergovigilance:ergovigilance@127.0.0.1:5432/ergovigilance
# Set true (and use the timescaledb image) for time-series hypertables.
#PG_TIMESCALEDB=false


# ── Trusted proxy ───────────────────────────────────────────────────────
# true when the app sits behind the nginx/ingress reverse proxy (which sets
# X-Forwarded-* and owns TLS). Do NOT publish :8000 publicly.
TRUST_PROXY_HEADERS=true

# ── AI Assistant (Ollama) ───────────────────────────────────────────────
# The chat + embedding models. `ollama pull qwen2.5:1.5b` and
# `ollama pull nomic-embed-text` must have been run on the host.
OLLAMA_HOST=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:1.5b
OLLAMA_EMBED_MODEL=nomic-embed-text

# ── Pose model (accuracy vs. throughput) ─────────────────────────────────
# MediaPipe pose landmarker task file. Default is the LITE model
# (models/pose_landmarker_lite.task) — ~15-20 FPS on a laptop CPU, tuned for
# webcam real-time ergonomic monitoring.
#
# For cluttered industrial scenes with more occlusion/scale variance, switch
# to the FULL/HEAVY model (models/pose_landmarker_full.task) at the cost of
# roughly 2-4x inference time (≈5-10 FPS on CPU; GPU via the MediaPipe
# delegate). Pick per deployment site: clean office → lite; warehouse/plant
# floor with heavy machinery → full.
# POSE_MODEL_PATH=/data/models/pose_landmarker_full.task

# ── Retention (optional; defaults are 30d sessions, 30d recordings, 20GB cap)
# SESSION_RETENTION_DAYS=30
# RECORDING_RETENTION_DAYS=30
# RECORDINGS_MAX_GB=20

# ── Data locations (override if the host layout differs) ────────────────
# OUTPUTS_DIR=/var/lib/ergovigilance/outputs
# RECORDINGS_DIR=/var/lib/ergovigilance/recordings

# ── IP / RTSP cameras (optional) ────────────────────────────────────────
# JSON array of factory IP cameras to expose alongside auto-detected USB
# cameras. Each entry: {"id", "name", "url"}. The id is what the frontend
# sends back as camera_id; the url is opened by cv2.VideoCapture.
# CAMERA_SOURCES=[{"id":"dock-cam-1","name":"Loading Dock","url":"rtsp://user:pass@192.168.1.50:554/stream1"},{"id":"line-2","name":"Assembly Line 2","url":"rtsp://admin:admin@192.168.1.51:554/ch1"}]
