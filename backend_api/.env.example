# ErgoVigilance API — Environment Configuration
# Copy to .env and adjust before running.

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# CORS — comma-separated origins allowed to access the API
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Repository
# Set to "true" to serve mock data, "false" to use the live backend.
# In live mode the API fails closed (HTTP 503) if the monitoring service is unavailable.
USE_MOCK_REPOSITORY=true

# Security
# REQUIRED when DEBUG=false — the server refuses to start without a strong
# secret (min 32 chars, and it rejects the known development default).
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_JWT_SECRET=

# Login brute-force protection is per-IP throttling of the token-issuing
# endpoints (/auth/login, /auth/demo): 10 attempts per minute per IP by default
# (HTTP 429 + Retry-After). Tune with RATE_LIMIT_AUTH_MAX / RATE_LIMIT_WINDOW.
# There is deliberately no per-account lockout — locking a known email would let
# anyone deny service to that user. Failed attempts are still written to the
# audit log.

# Set to "true" only when the API sits behind a trusted reverse proxy that
# overwrites X-Forwarded-For (e.g. the bundled nginx frontend). When false,
# the socket peer IP is used so clients cannot spoof the per-IP limit.
TRUST_PROXY_HEADERS=false

# JWT lifetime in seconds (default 8h). The login response reports
# expires_in/expires_at; the frontend drops expired tokens on reload.
AUTH_JWT_TTL_SECONDS=28800

# Logging
LOG_LEVEL=INFO

# Data retention (0 disables the corresponding check)
# NOTE: env values below are defaults — an admin edit via PUT /retention/config
# persists to config/retention.json and overrides them at runtime.
# Session summary JSONs older than this many days are deleted from outputs/sessions.
SESSION_RETENTION_DAYS=30
# Recorded session dirs (recordings/<worker>/<session>) older than this many days.
RECORDING_RETENTION_DAYS=30
# Hard cap on the recordings tree — oldest sessions are evicted first when exceeded.
RECORDINGS_MAX_GB=20
# Audit-trail JSONL files (AUDIT_LOG_DIR) older than this many days.
AUDIT_LOG_RETENTION_DAYS=365
# Alert rows in the local DB older than this many days (default: aligned with
# session retention; raise it if alert history must outlive session files).
ALERT_RETENTION_DAYS=30
# How often the retention pass runs in the background (hours).
RETENTION_INTERVAL_HOURS=6

# Operational endpoints (no auth, root-level):
#   /healthz  — liveness
#   /readyz   — readiness (503 until the app can serve real requests)
#   /metrics  — Prometheus text exposition
#   /health   — human-readable status with app/version/uptime
