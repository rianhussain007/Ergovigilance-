# ErgoVigilance API — Environment Configuration
# Copy to .env and adjust before running.

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# CORS — comma-separated origins allowed to access the API
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Repository
# Set to "true" to serve mock data, "false" to use the live backend.
# In live mode the API fails closed (HTTP 503) if the monitoring service is unavailable.
USE_MOCK_REPOSITORY=true

# Security
# REQUIRED when DEBUG=false — the server refuses to start without a strong
# secret (min 32 chars, and it rejects the known development default).
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_JWT_SECRET=

# Login brute-force protection is built in: 5 failed attempts per account or
# 10 per IP within 15 minutes locks that account/IP for 15 minutes (HTTP 429).
# Note: account lockout can be used to DoS a known email — keep short windows,
# add CAPTCHA, or monitor login_locked audit events in high-risk deployments.

# Set to "true" only when the API sits behind a trusted reverse proxy that
# overwrites X-Forwarded-For (e.g. the bundled nginx frontend). When false,
# the socket peer IP is used so clients cannot spoof the per-IP limit.
TRUST_PROXY_HEADERS=false

# Logging
LOG_LEVEL=INFO

# Data retention (0 disables the corresponding check)
# Session summary JSONs older than this many days are deleted from outputs/sessions.
SESSION_RETENTION_DAYS=30
# Recorded session dirs (recordings/<worker>/<session>) older than this many days.
RECORDING_RETENTION_DAYS=30
# Hard cap on the recordings tree — oldest sessions are evicted first when exceeded.
RECORDINGS_MAX_GB=20
# How often the retention pass runs in the background (hours).
RETENTION_INTERVAL_HOURS=6
