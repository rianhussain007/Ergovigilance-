# ══════════════════════════════════════════════════════════════════
# ErgoVigilance — Production Environment Configuration
# ══════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in the values before deploying.
# All variables have safe defaults for local development; production
# MUST set at least AUTH_JWT_SECRET and DEBUG=false.
# ══════════════════════════════════════════════════════════════════

# ── Security (CRITICAL for production) ────────────────────────────

# Set to false in production. When true, dev defaults for JWT are used.
DEBUG=false

# Strong random secret for JWT signing. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
AUTH_JWT_SECRET=REPLACE_WITH_STRONG_SECRET

# JWT token lifetime in seconds (default: 8h)
AUTH_JWT_TTL_SECONDS=28800

# ── Server / Network ──────────────────────────────────────────────

# Bind address (0.0.0.0 for Docker, 127.0.0.1 for local dev)
HOST=0.0.0.0
PORT=8000

# Comma-separated origins allowed for CORS (frontend URLs)
CORS_ORIGINS=http://localhost,http://localhost:8080

# Set to true when behind a trusted reverse proxy (nginx, traefik)
TRUST_PROXY_HEADERS=false

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ── Database ──────────────────────────────────────────────────────

# SQLite path for auth/users/alerts (auto-created if missing)
AUTH_DB_PATH=/data/local_auth.db

# PostgreSQL telemetry store (optional — without this, sessions use JSON files)
# Format: postgresql://user:password@host:5432/dbname
DATABASE_URL=

# Enable TimescaleDB hypertables (requires timescaledb extension)
PG_TIMESCALEDB=false

# ── PostgreSQL (Docker Compose) ───────────────────────────────────

POSTGRES_USER=ergovigilance
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=ergovigilance

# ── Ports (Docker Compose) ────────────────────────────────────────

BACKEND_PORT=8001
FRONTEND_PORT=8080
POSTGRES_PORT=5433

# ── Pose Model ────────────────────────────────────────────────────

# Path to MediaPipe pose model (relative to backend_api/)
POSE_MODEL_PATH=models/pose_landmarker_lite.task

# ── Camera / Video ────────────────────────────────────────────────

# Physical camera index (default: 0 = first USB camera)
CAMERA_INDEX=0

# IP cameras (JSON array) — adds RTSP/HTTP cameras to the UI
# Example: [{"id":"dock-1","name":"Loading Dock","url":"rtsp://admin:pass@192.168.1.100/stream"}]
CAMERA_SOURCES=

# Demo mode video file path (for sales demos without hardware)
DEMO_VIDEO_PATH=

# ── Performance Tuning ────────────────────────────────────────────

# Pose inference FPS (default: 15 — lower = less CPU, higher = smoother skeleton)
POSE_PROCESS_FPS=15

# Inference input width (default: 320 — lower = faster, ~180ms at 320 vs ~380ms at 1280)
POSE_INFERENCE_WIDTH=320

# Recording frame rate (default: 15)
RECORD_FPS=15

# ── Data Retention ────────────────────────────────────────────────

# How many days to keep session JSON files
SESSION_RETENTION_DAYS=30

# How many days to keep video recordings
RECORDING_RETENTION_DAYS=30

# Maximum total recording storage in GB (oldest deleted first)
RECORDINGS_MAX_GB=20

# How often (hours) to run the retention cleanup
RETENTION_INTERVAL_HOURS=6

# ── Notifications (Email) ────────────────────────────────────────

# SMTP server for email alerts
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Comma-separated email addresses to receive HIGH/CRITICAL alerts
ALERT_RECIPIENTS=

# Minimum severity to trigger email: LOW, MEDIUM, HIGH, CRITICAL
MIN_EMAIL_SEVERITY=HIGH

# ── Notifications (Slack) ─────────────────────────────────────────

# Slack incoming webhook URL for real-time alert delivery
SLACK_WEBHOOK_URL=

# ── AI Assistant (Ollama) ─────────────────────────────────────────

# Ollama server URL (for AI assistant chat)
OLLAMA_HOST=http://localhost:11434
